 /* Mode : resolution and related config&values */
 struct imx319_mode {
 	/* Frame width */
 	u32 width;
 	/* Frame height */
 	u32 height;
+	struct v4l2_rect analogue_crop;
 
 	/* V-timing */
 	u32 fll_def;
@@ -1693,6 +1698,10 @@
