+	mutex_lock(&port->lock);
+	if (!ret && (!tcpm_shutdown_contract_valid(port) ||
+		     port->shutdown_sequence != sequence))
+		ret = -EAGAIN;
+	goto finish_locked;
+finish:
+	mutex_lock(&port->lock);
+finish_locked:
+	port->shutdown_5v_pending = false;
+	port->shutdown_busy = false;
+unlock:
+	mutex_unlock(&port->lock);
+	mutex_unlock(&port->swap_lock);
+	return ret;
+}
