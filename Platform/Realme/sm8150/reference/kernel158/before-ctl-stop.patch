Subject: [PATCH] drm/msm/dpu: quiesce firmware DSI before boot CTL reset

The initial DPU boot CTL reset can fail before a native modeset runs.
Stop each bound DSI host with runtime bus clocks before clearing the
SM8150 boot configuration. Reuse the checked, one-shot host handoff
and keep the later before-PHY call as an idempotent fallback.

---

diff --git a/drivers/gpu/drm/msm/dsi/dsi.c b/drivers/gpu/drm/msm/dsi/dsi.c
--- a/drivers/gpu/drm/msm/dsi/dsi.c
+++ b/drivers/gpu/drm/msm/dsi/dsi.c
@@ -4,6 +4,11 @@
  */
 
 #include "dsi.h"
+
+int msm_dsi_quiesce_firmware(struct msm_dsi *msm_dsi)
+{
+	return msm_dsi_host_quiesce_firmware(msm_dsi->host);
+}
 
 bool msm_dsi_is_cmd_mode(struct msm_dsi *msm_dsi)
 {
diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -297,6 +297,7 @@
 int msm_dsi_modeset_init(struct msm_dsi *msm_dsi, struct drm_device *dev,
 			 struct drm_encoder *encoder);
 void msm_dsi_snapshot(struct msm_disp_state *disp_state, struct msm_dsi *msm_dsi);
+int msm_dsi_quiesce_firmware(struct msm_dsi *msm_dsi);
 bool msm_dsi_is_cmd_mode(struct msm_dsi *msm_dsi);
 bool msm_dsi_is_bonded_dsi(struct msm_dsi *msm_dsi);
 bool msm_dsi_is_master_dsi(struct msm_dsi *msm_dsi);
@@ -318,6 +319,11 @@
 }
 static inline void msm_dsi_snapshot(struct msm_disp_state *disp_state, struct msm_dsi *msm_dsi)
 {
+}
+
+static inline int msm_dsi_quiesce_firmware(struct msm_dsi *msm_dsi)
+{
+	return 0;
 }
 static inline bool msm_dsi_is_cmd_mode(struct msm_dsi *msm_dsi)
 {
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -1172,6 +1172,21 @@
 
 #define	DPU_PERF_DEFAULT_MAX_CORE_CLK_RATE	412500000
 
+static int dpu_kms_quiesce_boot_dsi(struct msm_kms *kms)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(kms->dsi); i++) {
+		if (!kms->dsi[i])
+			continue;
+		ret = msm_dsi_quiesce_firmware(kms->dsi[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
 static int dpu_kms_hw_init(struct msm_kms *kms)
 {
 	struct dpu_kms *dpu_kms;
@@ -1237,6 +1252,12 @@
 
 	/* The boot framebuffer uses physical addresses in the identity domain. */
 	if (of_device_is_compatible(dev->dev->of_node, "qcom,sm8150-dpu")) {
+		/* Stop the firmware DSI consumer before resetting its CTL producer. */
+		rc = dpu_kms_quiesce_boot_dsi(kms);
+		if (rc) {
+			DPU_ERROR("DSI firmware stop failed: %d\n", rc);
+			goto err_pm_put;
+		}
 		rc = dpu_rm_clear_boot_config(&dpu_kms->rm, dpu_kms->catalog);
 		if (rc) {
 			DPU_ERROR("boot CTL shutdown failed: %d\n", rc);
