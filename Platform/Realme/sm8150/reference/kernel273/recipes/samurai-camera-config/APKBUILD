94ea1c0cba212cc0b0ede1638cb96bf6533395d123984716f9fed25bcfcb97b469b1fb40f7e7e701b74b4e5f417e85f9ae5b4742300ed0791e5e9b441b27ccf5  samurai-camera-heaps.conf
2d1987abb9bad59b74dd8ef271ee57c49e8058895a85cf1473a25d1e4f11402e0e479c26cd4ab13caf1dd30814a21261243dcdb5782e77b151af61456fffcf5a  70-samurai-camera-heaps.rules
"
