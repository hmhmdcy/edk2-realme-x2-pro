# Realme X2 Pro front camera; retain other board settings and Image183 ABI.
CONFIG_I2C_QCOM_CCI=m
CONFIG_MFD_QCOM_PM8008=m
CONFIG_REGULATOR_QCOM_PM8008=m
CONFIG_VIDEO_IMX471=m
CONFIG_V4L2_CCI=m
CONFIG_V4L2_CCI_I2C=m
# CONFIG_OF_SAMURAI_CCI_BRINGUP is not set
# CONFIG_OF_SAMURAI_FRONT_IDENTIFY is not set
# CONFIG_OF_SAMURAI_PMIC_FIXTURE is not set
# CONFIG_OF_SAMURAI_VIO_PHANDLE is not set
# CONFIG_OF_SAMURAI_FRONT_OVERLAY is not set
