--- a/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
@@ -915,7 +915,7 @@
 
 /* Native 19781 CSIPHY rail; CAMSS remains disabled pending sensor/CPAS proof. */
 &camss {
-	/* Internal CSID TPG; CCI and all external sensors remain disabled. */
+	/* Physical front sensor and internal CSID test-pattern support. */
 	status = "okay";
 	vdda-phy-supply = <&vreg_l3c_1p2>;
 };
@@ -937,3 +937,129 @@
         bias-pull-up;
     };
 };
+
+/* Realme X2 Pro front camera, verified with physical IMX471 RAW frames. */
+#include <dt-bindings/clock/qcom,sm8150-camcc.h>
+#include <dt-bindings/media/video-interfaces.h>
+
+&pm8150l_gpios {
+	/* The unused rear PMIC shares the factory address with the front PMIC. */
+	cam_rear_reset_hog: camera-rear-reset-hog {
+		gpio-hog;
+		gpios = <1 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "camera-rear-reset";
+	};
+};
+
+&i2c4 {
+	pmic@4 {
+		compatible = "qcom,pm8008";
+		reg = <4>;
+		qcom,initial-address = <8>;
+		reset-gpios = <&pm8150l_gpios 4 GPIO_ACTIVE_LOW>;
+		vdd-l1-l2-supply = <&vreg_s8c_1p3>;
+
+		/* The four PLDO input nets have not yet been identified. */
+		regulators {
+			cam_front_vdig: ldo2 {
+				regulator-name = "cam-front-vdig";
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1056000>;
+				regulator-enable-ramp-delay = <1000>;
+			};
+
+			cam_front_vana: ldo5 {
+				regulator-name = "cam-front-vana";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-enable-ramp-delay = <1000>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	cam_front_mclk_active: camera-front-mclk-active-state {
+		pins = "gpio15";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_front_mclk_sleep: camera-front-mclk-sleep-state {
+		pins = "gpio15";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	cam_front_select_active: camera-front-select-active-state {
+		pins = "gpio29";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	cam_front_select_sleep: camera-front-select-sleep-state {
+		pins = "gpio29";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-low;
+	};
+
+	cam_front_reset: camera-front-reset-state {
+		pins = "gpio12";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	cam_front: camera@10 {
+		compatible = "sony,imx471";
+		reg = <0x10>;
+		vana-supply = <&cam_front_vana>;
+		vdig-supply = <&cam_front_vdig>;
+		vif-supply = <&vreg_l1c_1p8>;
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_front_mclk_active &cam_front_select_active &cam_front_reset>;
+		pinctrl-1 = <&cam_front_mclk_sleep &cam_front_select_sleep &cam_front_reset>;
+		orientation = <0>;
+
+		port {
+			cam_front_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <200000000>;
+				remote-endpoint = <&cam_front_csiphy2_ep>;
+			};
+		};
+	};
+};
+
+&camss {
+	ports {
+		port@2 {
+			reg = <2>;
+
+			cam_front_csiphy2_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_front_ep>;
+			};
+		};
+	};
+};
