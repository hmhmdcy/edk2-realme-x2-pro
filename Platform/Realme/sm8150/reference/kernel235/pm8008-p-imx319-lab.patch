+static int pm8008_lab_assert_p_reset(void *data)
+{
+	struct pm8008_reset *reset = data;
+	int ret;
+
+	if (!reset || !reset->control || reset->gpio)
+		return -EINVAL;
+	ret = pm8008_set_reset(reset, true);
+	if (ret)
+		return ret;
+	ret = reset_control_status(reset->control);
+	return ret < 0 ? ret : ret == 1 ? 0 : -EIO;
+}
