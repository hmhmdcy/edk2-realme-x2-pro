--- a/src/ipa/libipa/gamma_curve.h
+++ b/src/ipa/libipa/gamma_curve.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace libcamera::ipa {
+using GammaCurve = std::array<float, 65>;
+using GammaLut = std::array<uint32_t, 64>;
+
+/* Input/output are in the native 10-bit Gamma16 domain. The 65th sample
+ * supplies the final slope. This encoder does not upload or activate a LUT. */
+bool encodeGammaCurve(const GammaCurve &curve, GammaLut *lut);
+} /* namespace libcamera::ipa */
--- a/src/ipa/libipa/gamma_curve.cpp
+++ b/src/ipa/libipa/gamma_curve.cpp
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "gamma_curve.h"
+#include <algorithm>
+#include <cmath>
+
+namespace libcamera::ipa {
+bool encodeGammaCurve(const GammaCurve &curve, GammaLut *lut)
+{
+ if (!lut)
+  return false;
+ for (float sample : curve)
+  if (!std::isfinite(sample) || sample < 0.0f || sample > 1024.0f)
+   return false;
+
+ GammaLut result;
+ for (unsigned int i = 0; i < result.size(); ++i) {
+  int base = std::min(static_cast<int>(std::round(curve[i])), 1023);
+  int next = std::min(static_cast<int>(std::round(curve[i + 1])),
+                      i + 1 == result.size() ? 1024 : 1023);
+  int delta = std::clamp(next - base, -512, 511);
+  result[i] = static_cast<uint32_t>(base) |
+              ((static_cast<uint32_t>(delta) & 0x3ff) << 10);
+ }
+ *lut = result;
+ return true;
+}
+} /* namespace libcamera::ipa */
--- a/src/ipa/camss-vfe/gamma_profile.cpp
+++ b/src/ipa/camss-vfe/gamma_profile.cpp
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "gamma_profile.h"
+#include <array>
+#include <cerrno>
+#include "libcamera/internal/yaml_parser.h"
+#include "../libipa/gamma_curve.h"
+
+namespace libcamera::ipa::camss {
+int configureGammaProfile(const ValueNode &tuning,
+                          std::optional<camss_params_ife_gamma> *parameters)
+{
+ if (!parameters)
+  return -EINVAL;
+ parameters->reset();
+ if (tuning.isEmpty())
+  return 0;
+ if (!tuning.isDictionary())
+  return -EINVAL;
+ if (!tuning["enabled"].isEmpty()) {
+  auto enabled = tuning["enabled"].get<bool>();
+  if (!enabled)
+   return -EINVAL;
+  if (!*enabled)
+   return 0;
+ }
+ if (tuning["mode"].get<std::string>("static") != "static")
+  return -EINVAL;
+ const auto &curves = tuning["curves"];
+ if (!curves.isList() || curves.size() != 3)
+  return -EINVAL;
+ camss_params_ife_gamma result{};
+ result.header = {CAMSS_PARAMS_IFE_GAMMA, V4L2_ISP_PARAMS_FL_BLOCK_ENABLE,
+                  sizeof(result)};
+ for (unsigned int ch = 0; ch < 3; ++ch) {
+  const auto &values = curves[ch];
+  if (!values.isList() || values.size() != 65)
+   return -EINVAL;
+  GammaCurve curve;
+  for (unsigned int i = 0; i < curve.size(); ++i) {
+   auto sample = values[i].get<float>();
+   if (!sample)
+    return -EINVAL;
+   curve[i] = *sample;
+  }
+  GammaLut packed;
+  if (!encodeGammaCurve(curve, &packed))
+   return -EINVAL;
+  for (unsigned int i = 0; i < packed.size(); ++i) {
+   result.segments[ch][i].base = packed[i] & 1023;
+   unsigned int delta = (packed[i] >> 10) & 1023;
+   result.segments[ch][i].delta = delta >= 512 ? int(delta) - 1024 : int(delta);
+  }
+ }
+ *parameters = result;
+ return 0;
+}
+} /* namespace libcamera::ipa::camss */
