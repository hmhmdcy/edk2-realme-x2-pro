 /**
+ * \brief Gather spatial green contrast before returning the input buffer
+ * \param[in] frame Frame identity, with the same cadence as colour statistics
+ * \param[in] input Mapped and DMA-synchronized RAW input
+ * \param[in] window Input-relative crop corresponding to the processed image
+ */
+void SwStatsCpu::processFocusStats(uint32_t frame, MappedFrameBuffer &input,
+				 const Rectangle &window)
+{
+	if (frame % kStatPerNumFrames)
+		return;
+
+	sharedStats_->focus = {};
+	if (input.planes().empty() || window.x < 0 || window.y < 0)
+		return;
+	if (focusFormat_.packing != BayerFormat::Packing::None &&
+	    focusFormat_.packing != BayerFormat::Packing::CSI2)
+		return;
+
+	FocusBayerFormat format{
+		focusFormat_.bitDepth,
+		focusFormat_.packing == BayerFormat::Packing::CSI2,
+		focusFormat_.order == BayerFormat::GBRG ||
+			focusFormat_.order == BayerFormat::GRBG,
+		quadBayer_,
+	};
+	sharedStats_->focus = measureBayerFocus(input.planes()[0].data(),
+					      input.planes()[0].size(),
+					      inputSize_.width, inputSize_.height, stride_,
+					      window.x, window.y, window.width, window.height,
+					      format);
+}
