--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -676,6 +676,14 @@
 	}
 
 	inputConfig_.stride = inputCfg.stride;
+
+	statsOnly_ = outputCfgs.empty();
+	if (statsOnly_) {
+		window_ = Rectangle(inputCfg.size);
+		stats_->setWindow(window_);
+		LOG(Debayer, Info) << "RAW-only CPU statistics enabled";
+		return 0;
+	}
 
 	if (outputCfgs.size() != 1) {
 		LOG(Debayer, Error)
@@ -1140,6 +1148,21 @@
 
 	dmaSyncBegin(dmaSyncers, input, output);
 
+	if (statsOnly_) {
+		ASSERT(!output);
+		MappedFrameBuffer in(input, MappedFrameBuffer::MapFlag::Read);
+		if (!in.isValid() || in.planes().empty() ||
+		    in.planes()[0].size() < size_t(inputConfig_.stride) * inputSize_.height) {
+			LOG(Debayer, Error) << "Invalid RAW statistics input buffer";
+			input->_d()->metadata().status = FrameMetadata::FrameError;
+		} else {
+			stats_->processFrame(frame, 0, in);
+		}
+		dmaSyncers.clear();
+		inputBufferReady.emit(input);
+		return;
+	}
+
 	updateLookupTables(params);
 
 	/* Copy metadata from the input buffer */
