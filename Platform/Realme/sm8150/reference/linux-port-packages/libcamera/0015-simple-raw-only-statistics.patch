 			   const std::vector<std::reference_wrapper<const StreamConfiguration>> &outputCfgs,
 			   const ipa::soft::IPAConfigInfo &configInfo)
@@ -343,6 +348,7 @@
 	ret = debayer_->configure(inputCfg, outputCfgs, ccmEnabled_);
 	if (ret < 0)
 		return ret;
+	statsOnly_ = outputCfgs.empty();
 
 	LOG(SoftwareIsp, Info)
 		<< "Input " << inputCfg.size
@@ -393,10 +399,16 @@
 int SoftwareIsp::queueBuffers(uint32_t frame, FrameBuffer *input,
 			      const std::map<const Stream *, FrameBuffer *> &outputs)
 {
-	/*
-	 * Validate the outputs as a sanity check: at least one output is
-	 * required, all outputs must reference a valid stream.
-	 */
+	/* RAW-only statistics hold the input until CPU reads have finished. */
+	if (statsOnly_) {
+		if (!outputs.empty())
+			return -EINVAL;
+		queuedInputBuffers_.push_back(input);
+		process(frame, input, nullptr);
+		return 0;
+	}
+
+	/* Converted output requires one valid stream and buffer. */
 	if (outputs.empty())
 		return -EINVAL;
 
