014766c373bc84b46e0bfabb7cf8a10de469817c1233086de594785e4c8125f979416610135ccb1bafbfa389de722a2b96b465b889d0371deed11dd157f181fd  0001-defer-pool-buffer-recycle.patch
63537a5c9918b54916422e3fbadf49e78abe9115cc22c189eba4763654b31c01ff80127c5e49609f21e96df92b68ffcb831676c3b05180919d035f8be96de2ca  0002-camera-copy-profile.patch
"
