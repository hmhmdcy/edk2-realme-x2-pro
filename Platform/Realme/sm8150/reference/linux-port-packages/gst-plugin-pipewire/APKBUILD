# Maintainer: Realme X2 Pro Linux port
pkgname=gst-plugin-pipewire
pkgver=1.6.9
pkgrel=1
pkgdesc="PipeWire GStreamer plugin with opt-in CPU camera buffer ownership"
url="https://pipewire.org"
arch="aarch64"
license="MIT"
depends="pipewire-session-manager gst-plugins-base"
install_if="pipewire=$pkgver-r0 gstreamer"
makedepends="pipewire-dev=$pkgver-r0 gstreamer-dev gst-plugins-base-dev"
source="pipewire-$pkgver.tar.gz::https://github.com/PipeWire/pipewire/archive/refs/tags/$pkgver.tar.gz
	0001-defer-pool-buffer-recycle.patch
	0002-camera-copy-profile.patch"
builddir="$srcdir/pipewire-$pkgver"
options="!check" # Real camera regression is performed on the handset.

build() {
	cat > "$srcdir/config.h" <<-EOF
	#define PACKAGE "pipewire"
	#define PACKAGE_VERSION "$pkgver"
	#define HAVE_GSTREAMER_DEVICE_PROVIDER 1
	#define HAVE_GSTREAMER_DMA_DRM 1
	#define HAVE_GSTREAMER_SHM_ALLOCATOR 1
	EOF
	cc -shared -fPIC $CFLAGS $LDFLAGS \
		-I"$srcdir" -Isrc \
		$(pkg-config --cflags libpipewire-0.3 gstreamer-1.0 gstreamer-base-1.0 \
		gstreamer-video-1.0 gstreamer-audio-1.0 gstreamer-net-1.0 gstreamer-allocators-1.0) \
		src/gst/*.c \
		$(pkg-config --libs libpipewire-0.3 gstreamer-1.0 gstreamer-base-1.0 \
		gstreamer-video-1.0 gstreamer-audio-1.0 gstreamer-net-1.0 gstreamer-allocators-1.0) \
		-lm -o libgstpipewire.so
}

package() {
	install -Dm755 libgstpipewire.so "$pkgdir/usr/lib/gstreamer-1.0/libgstpipewire.so"
}

