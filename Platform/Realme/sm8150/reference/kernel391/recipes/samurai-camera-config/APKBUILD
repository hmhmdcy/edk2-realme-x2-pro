# Device configuration only; camera and kernel binaries are packaged separately.
pkgname=samurai-camera-config
pkgver=0.1.0
pkgrel=25
pkgdesc="Realme X2 Pro CAMSS hardware tuning, software fallback and camera heap access"
url="https://github.com/hmhmdcy/edk2-realme-x2-pro"
arch="noarch"
license="LicenseRef-Local-Project"
depends="libcamera=99990.7.2-r30 libcamera-ipa=99990.7.2-r30 openrc eudev"
subpackages="samurai-camera-stack:stack"
options="!check"
source="configuration.yaml samurai-camera-heaps.conf 70-samurai-camera-heaps.rules s5kgw1.yaml camss-s5kgw1.yaml camss-imx471.yaml camss-imx319.yaml camss-s5k3m5.yaml"

package() {
	for model in s5kgw1 imx471 imx319 s5k3m5; do
		install -Dm644 "$srcdir"/camss-$model.yaml "$pkgdir"/usr/share/libcamera/ipa/camss-vfe/$model.yaml
	done
	install -Dm644 "$srcdir"/s5kgw1.yaml "$pkgdir"/usr/share/libcamera/ipa/simple/s5kgw1.yaml
	install -Dm644 "$srcdir"/configuration.yaml "$pkgdir"/etc/libcamera/configuration.yaml
	install -Dm644 "$srcdir"/samurai-camera-heaps.conf "$pkgdir"/etc/modules-load.d/samurai-camera-heaps.conf
	install -Dm644 "$srcdir"/70-samurai-camera-heaps.rules "$pkgdir"/etc/udev/rules.d/70-samurai-camera-heaps.rules
	chmod 755 "$pkgdir"/etc/libcamera
}

stack() {
	pkgdesc="Pinned Realme X2 Pro camera framework and device configuration"
	depends="samurai-camera-config=$pkgver-r$pkgrel libcamera=99990.7.2-r30 libcamera-ipa=99990.7.2-r30 libcamera-tools=99990.7.2-r30 libcamera-gstreamer=99990.7.2-r30 libcamera-v4l2=99990.7.2-r30"
	mkdir -p "$subpkgdir"
}

