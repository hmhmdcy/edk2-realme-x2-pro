+			continue;
+		for (i = 0; i < CAMSS_INIT_BUF_COUNT; i++) {
+			struct camss_buffer *buf = output->buf[i];
+
+			if (buf && !buf->sof_valid) {
+				buf->vb.sequence = event.u.frame_sync.frame_sequence;
