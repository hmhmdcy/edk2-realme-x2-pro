diff --git a/drivers/power/supply/gauge-protocol.h b/drivers/power/supply/gauge-protocol.h
new file mode 100644
--- /dev/null
+++ b/drivers/power/supply/gauge-protocol.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SAMURAI_GAUGE_PROTOCOL_H
+#define SAMURAI_GAUGE_PROTOCOL_H
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#else
+#include <errno.h>
+#endif
+
+/* TI SLUUA65E 12.1.28-31: 2 command + 0..32 data + checksum + length.
+ * The checksum/length always occupy offsets 34/35 of a 36-byte read.
+ */
+static inline unsigned int sm_le16(const unsigned char *p)
+{
+	return p[0] | (unsigned int)p[1] << 8;
+}
+
+static inline unsigned int sm_le32(const unsigned char *p)
+{
+	return sm_le16(p) | sm_le16(p + 2) << 16;
+}
+
+static inline int sm_mac_data_size(unsigned int command)
+{
+	switch (command) {
+	case 0x0001: return 2;
+	case 0x0051: case 0x0053: case 0x0054: return 4;
+	case 0x0057: return 2;
+	case 0x0071: return 32;
+	default: return -EINVAL; /* No arbitrary MAC, FET, unseal or NVM commands. */
+	}
+}
+
+static inline int sm_mac_validate(const unsigned char *p, unsigned int bytes,
+				  unsigned int command)
+{
+	unsigned int sum = 0, i;
+	int size = sm_mac_data_size(command);
+
+	if (size < 0) return size;
+	if (bytes != 36 || p[35] != size + 4) return -EMSGSIZE;
+	if (sm_le16(p) != command) return -EAGAIN;
+	for (i = 0; i < (unsigned int)size + 2; i++) sum += p[i];
+	return ((sum + p[34]) & 255) == 255 ? 0 : -EBADMSG;
+}
+
+/* A valid protocol response is not a claim that the silicon is a standard
+ * TI 2610. The installed factory-family protocol reports device type 2719.
+ * Keep the observed identity explicit; do not silently accept unknown packs.
+ */
+static inline int sm_gauge_protection_state(unsigned int device_type,
+	unsigned int safety, unsigned int permanent, unsigned int operation,
+	unsigned int manufacturing)
+{
+	if (device_type != 0x2719) return -ENODEV;
+	if (safety || permanent) return -EIO;
+	/* Require sealed state, autonomous FET action and gauging. Exclude test,
+	 * calibration, shutdown, disabled-charge and active safety/PF modes.
+	 * PF_EN is reported separately; its inherited value must not be changed.
+	 */
+	if ((operation & 0x300) != 0x300 ||
+	    (operation & ((1U << 20) | (1U << 16) | 0x7c00)) ||
+	    (manufacturing & 0x18) != 0x18 || (manufacturing & 0x8006))
+		return -EACCES;
+	return 0;
+}
+#endif
diff --git a/drivers/power/supply/gauge-i2c.h b/drivers/power/supply/gauge-i2c.h
new file mode 100644
--- /dev/null
+++ b/drivers/power/supply/gauge-i2c.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SAMURAI_GAUGE_I2C_H
+#define SAMURAI_GAUGE_I2C_H
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include "gauge-protocol.h"
+
+/* Caller holds I2C_LOCK_SEGMENT. No other MAC client may interleave. */
+static inline int sm_gauge_word_locked(struct i2c_client *g, unsigned int reg,
+				       bool write, unsigned int value)
+{
+	union i2c_smbus_data data = { .word = value };
+	int ret = __i2c_smbus_xfer(g->adapter, g->addr, g->flags,
+		write ? I2C_SMBUS_WRITE : I2C_SMBUS_READ, reg,
+		I2C_SMBUS_WORD_DATA, &data);
+	return ret < 0 ? ret : write ? 0 : data.word;
+}
+
+static inline int sm_gauge_mac_locked(struct i2c_client *g, unsigned int command,
+				      unsigned char *packet)
+{
+	unsigned char start = 0x3e;
+	struct i2c_msg messages[] = {
+		{ .addr = g->addr, .len = 1, .buf = &start },
+		{ .addr = g->addr, .flags = I2C_M_RD, .len = 36, .buf = packet },
+	};
+	int ret;
+
+	if (sm_mac_data_size(command) < 0) return -EINVAL;
+	ret = sm_gauge_word_locked(g, 0x3e, true, command);
+	if (ret) return ret;
+	usleep_range(1000, 1500); /* matched OEM query delay, no NVM transaction */
+	ret = __i2c_transfer(g->adapter, messages, ARRAY_SIZE(messages));
+	if (ret != ARRAY_SIZE(messages)) return ret < 0 ? ret : -EIO;
+	return sm_mac_validate(packet, 36, command);
+}
+#endif
diff --git a/drivers/power/supply/samurai-usb-input.c b/drivers/power/supply/samurai-usb-input.c
new file mode 100644
--- /dev/null
+++ b/drivers/power/supply/samurai-usb-input.c
@@ -0,0 +1,348 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RMX1931 input observer: no PMIC, charger, USB role or PD writes. */
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/pm.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#include "samurai-usb-input-decode.h"
+
+static bool register_board;
+module_param(register_board, bool, 0444);
+MODULE_PARM_DESC(register_board, "Create a PM8150B read-only input device using observed board wiring");
+static struct platform_device *samurai_usb_board;
+static bool native_retained;
+module_param(native_retained, bool, 0444);
+MODULE_PARM_DESC(native_retained, "Native DWC3 reference requires this provider until next boot");
+
+struct samurai_usb_input {
+	struct regmap *map;
+	struct power_supply *psy;
+	struct mutex lock;
+	struct delayed_work work;
+	struct samurai_usb_budget last;
+	int last_error;
+	bool last_valid;
+	bool udc_valid;
+	bool paused;
+	int udc_current_ua;
+};
+
+static int samurai_usb_read_status(struct samurai_usb_input *input,
+				   struct samurai_usb_status *s)
+{
+	static const unsigned int registers[] = {
+		0x1307, 0x1308, 0x1310, 0x1506, 0x1509, 0x150b, 0x150d,
+	};
+	unsigned char *fields[] = {
+		&s->apsd, &s->result, &s->plugin, &s->cc,
+		&s->attached, &s->misc, &s->legacy,
+	};
+	unsigned int value, i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		ret = regmap_read(input->map, registers[i], &value);
+		if (ret)
+			return ret;
+		*fields[i] = value;
+	}
+	return 0;
+}
+
+static int samurai_usb_get_budget(struct samurai_usb_input *input,
+				  struct samurai_usb_budget *budget)
+{
+	struct samurai_usb_status before, after;
+	int ret;
+
+	mutex_lock(&input->lock);
+	if (input->paused) {
+		input->udc_valid = false;
+		mutex_unlock(&input->lock);
+		return -ENODATA;
+	}
+	ret = samurai_usb_read_status(input, &before);
+	if (!ret)
+		ret = samurai_usb_read_status(input, &after);
+	if (!ret && !samurai_usb_status_equal(&before, &after))
+		ret = -EAGAIN;
+	if (!ret)
+		ret = samurai_usb_decode(&after, budget);
+	if (ret || !budget->online)
+		input->udc_valid = false;
+	if (!ret)
+		ret = samurai_usb_apply_udc(budget, input->udc_valid, input->udc_current_ua);
+	mutex_unlock(&input->lock);
+	return ret;
+}
+
+static enum power_supply_usb_type samurai_usb_type(enum samurai_usb_kind kind)
+{
+	switch (kind) {
+	case SAMURAI_USB_SDP: return POWER_SUPPLY_USB_TYPE_SDP;
+	case SAMURAI_USB_CDP: return POWER_SUPPLY_USB_TYPE_CDP;
+	case SAMURAI_USB_DCP: return POWER_SUPPLY_USB_TYPE_DCP;
+	case SAMURAI_USB_TYPE_C: return POWER_SUPPLY_USB_TYPE_C;
+	default: return POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	}
+}
+
+static enum power_supply_property samurai_usb_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+};
+
+static int samurai_usb_get_property(struct power_supply *psy,
+				    enum power_supply_property property,
+				    union power_supply_propval *value)
+{
+	struct samurai_usb_input *input = power_supply_get_drvdata(psy);
+	struct samurai_usb_budget budget;
+	int ret = samurai_usb_get_budget(input, &budget);
+
+	if (ret)
+		return ret == -EAGAIN ? -ENODATA : ret;
+	switch (property) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		value->intval = budget.online;
+		return 0;
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		value->intval = samurai_usb_type(budget.kind);
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		if (budget.current_ua < 0)
+			return budget.current_ua;
+		value->intval = budget.current_ua;
+		return 0;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		mutex_lock(&input->lock);
+		ret = input->udc_valid ? 0 : -ENODATA;
+		value->intval = input->udc_current_ua;
+		mutex_unlock(&input->lock);
+		return ret;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int samurai_usb_set_property(struct power_supply *psy,
+				    enum power_supply_property property,
+				    const union power_supply_propval *value)
+{
+	struct samurai_usb_input *input = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	if (property != POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT) return -EINVAL;
+	mutex_lock(&input->lock);
+	input->udc_valid = false;
+	if (input->paused) ret = -EBUSY;
+	else if (value->intval < 0 || value->intval > 500000) ret = -ERANGE;
+	else {
+		input->udc_current_ua = value->intval;
+		input->udc_valid = true;
+	}
+	mutex_unlock(&input->lock);
+	power_supply_changed(psy);
+	return ret;
+}
+
+static const struct power_supply_desc samurai_usb_desc = {
+	.name = "samurai-usb-input",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) |
+		BIT(POWER_SUPPLY_USB_TYPE_SDP) | BIT(POWER_SUPPLY_USB_TYPE_CDP) |
+		BIT(POWER_SUPPLY_USB_TYPE_DCP) | BIT(POWER_SUPPLY_USB_TYPE_C),
+	.properties = samurai_usb_properties,
+	.num_properties = ARRAY_SIZE(samurai_usb_properties),
+	.get_property = samurai_usb_get_property,
+	/* No writable sysfs property: the existing DWC3 kernel callback supplies
+	 * this software allowance through power_supply_set_property().
+	 */
+	.set_property = samurai_usb_set_property,
+};
+
+static void samurai_usb_poll(struct work_struct *work)
+{
+	struct samurai_usb_input *input = container_of(to_delayed_work(work),
+						      struct samurai_usb_input, work);
+	struct samurai_usb_budget budget = { 0 };
+	int ret = samurai_usb_get_budget(input, &budget);
+	bool changed = !input->last_valid || ret != input->last_error ||
+		(!ret && (budget.online != input->last.online ||
+			  budget.kind != input->last.kind ||
+			  budget.current_ua != input->last.current_ua));
+
+	input->last = budget;
+	input->last_error = ret;
+	input->last_valid = true;
+	if (changed)
+		power_supply_changed(input->psy);
+	mutex_lock(&input->lock);
+	if (!input->paused)
+		schedule_delayed_work(&input->work, msecs_to_jiffies(1000));
+	mutex_unlock(&input->lock);
+}
+
+static void samurai_usb_stop(void *data)
+{
+	struct samurai_usb_input *input = data;
+
+	mutex_lock(&input->lock);
+	input->paused = true;
+	input->udc_valid = false;
+	mutex_unlock(&input->lock);
+	cancel_delayed_work_sync(&input->work);
+}
+
+static int samurai_usb_suspend(struct device *dev)
+{
+	samurai_usb_stop(dev_get_drvdata(dev));
+	return 0;
+}
+
+static int samurai_usb_resume(struct device *dev)
+{
+	struct samurai_usb_input *input = dev_get_drvdata(dev);
+	mutex_lock(&input->lock);
+	input->udc_valid = false;
+	input->paused = false;
+	mutex_unlock(&input->lock);
+	mod_delayed_work(system_wq, &input->work, 0);
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(samurai_usb_pm_ops, samurai_usb_suspend, samurai_usb_resume);
+
+static void samurai_usb_retain_for_native_consumer(struct device *dev)
+{
+	struct device_node *node;
+	const char *name;
+
+	/* DWC3 owns its supply reference for the controller's lifetime. Current
+	 * power_supply_unregister() warns if such a reference remains; unloading
+	 * this module would also invalidate its property callbacks. Do not permit
+	 * that lifecycle after native wiring has been selected in the boot DT.
+	 */
+	node = of_find_node_by_path("/soc@0/usb@a6f8800/usb@a600000");
+	if (node && !of_property_read_string(node, "usb-psy-name", &name) &&
+	    !strcmp(name, "samurai-usb-input") && !native_retained) {
+		__module_get(THIS_MODULE);
+		native_retained = true;
+		dev_info(dev, "native DWC3 supply retained until next boot\n");
+	}
+	of_node_put(node);
+}
+
+static int samurai_usb_probe(struct platform_device *pdev)
+{
+	struct power_supply_config config = { 0 };
+	struct samurai_usb_input *input;
+	struct device *dev = &pdev->dev;
+	u32 base;
+	int ret;
+
+	if (!of_machine_is_compatible("realme,samurai") ||
+	    !of_device_is_compatible(dev->parent->of_node, "qcom,pm8150b"))
+		return -ENODEV;
+	if (!of_node_name_eq(dev->parent->of_node, "pmic") ||
+	    of_property_read_u32(dev->parent->of_node, "reg", &base) || base != 2)
+		return -ENODEV;
+	if (device_property_read_u32(dev, "reg", &base) || base != 0x1300)
+		return -EINVAL;
+	input = devm_kzalloc(dev, sizeof(*input), GFP_KERNEL);
+	if (!input)
+		return -ENOMEM;
+	input->map = dev_get_regmap(dev->parent, NULL);
+	if (!input->map)
+		return -ENODEV;
+	mutex_init(&input->lock);
+	platform_set_drvdata(pdev, input);
+	INIT_DELAYED_WORK(&input->work, samurai_usb_poll);
+	config.drv_data = input;
+	/* A runtime software node already has a link named for its platform
+	 * parent. Reusing it for a same-named power_supply creates duplicate
+	 * sysfs links and unbalanced software-node removal references.
+	 * DT nodes retain the established firmware associations.
+	 */
+	config.fwnode = dev->of_node ? dev_fwnode(dev) : NULL;
+	input->psy = devm_power_supply_register(dev, &samurai_usb_desc, &config);
+	if (IS_ERR(input->psy))
+		return PTR_ERR(input->psy);
+	/* LIFO devres: stop polling before the supply and PMIC map are released. */
+	ret = devm_add_action_or_reset(dev, samurai_usb_stop, input);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&input->work, 0);
+	samurai_usb_retain_for_native_consumer(dev);
+	dev_info(dev, "read-only PM8150B USB input budget registered\n");
+	return 0;
+}
+
+static const struct of_device_id samurai_usb_match[] = {
+	{ .compatible = "realme,rmx1931-usb-input" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, samurai_usb_match);
+
+static struct platform_driver samurai_usb_driver = {
+	.probe = samurai_usb_probe,
+	.driver = {
+		.name = "samurai-usb-input",
+		.of_match_table = samurai_usb_match,
+		.pm = pm_sleep_ptr(&samurai_usb_pm_ops),
+		.suppress_bind_attrs = true,
+	},
+};
+
+static int samurai_usb_parent_match(struct device *dev, const void *unused)
+{
+	u32 sid;
+	return dev->parent && dev->parent->of_node &&
+		of_device_is_compatible(dev->parent->of_node, "qcom,pm8150b") &&
+		!of_property_read_u32(dev->parent->of_node, "reg", &sid) && sid == 2;
+}
+
+static int __init samurai_usb_init(void)
+{
+	static const struct property_entry props[] = {
+		PROPERTY_ENTRY_U32("reg", 0x1300), { }
+	};
+	struct platform_device_info info = { .name = "samurai-usb-input",
+		.id = PLATFORM_DEVID_NONE, .properties = props };
+	struct device *child;
+	int ret = platform_driver_register(&samurai_usb_driver);
+
+	if (ret || !register_board) return ret;
+	if (!of_machine_is_compatible("realme,samurai")) { ret = -ENODEV; goto fail; }
+	child = bus_find_device(&platform_bus_type, NULL, NULL, samurai_usb_parent_match);
+	if (!child) { ret = -ENODEV; goto fail; }
+	info.parent = child->parent;
+	samurai_usb_board = platform_device_register_full(&info);
+	put_device(child);
+	if (IS_ERR(samurai_usb_board)) { ret = PTR_ERR(samurai_usb_board); goto fail; }
+	return 0;
+fail:
+	platform_driver_unregister(&samurai_usb_driver);
+	return ret;
+}
+
+static void __exit samurai_usb_exit(void)
+{
+	if (register_board && !IS_ERR_OR_NULL(samurai_usb_board))
+		platform_device_unregister(samurai_usb_board);
+	platform_driver_unregister(&samurai_usb_driver);
+}
+module_init(samurai_usb_init);
+module_exit(samurai_usb_exit);
+MODULE_DESCRIPTION("RMX1931 read-only PM8150B USB input budget observer");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/samurai-usb-input-decode.h b/drivers/power/supply/samurai-usb-input-decode.h
new file mode 100644
--- /dev/null
+++ b/drivers/power/supply/samurai-usb-input-decode.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SAMURAI_USB_INPUT_DECODE_H
+#define SAMURAI_USB_INPUT_DECODE_H
+
+/* Status fields from the RMX1931 OEM SMB5 header and PM8150B Type-C driver. */
+struct samurai_usb_status {
+	unsigned char apsd, result, plugin, cc, attached, misc, legacy;
+};
+
+enum samurai_usb_kind {
+	SAMURAI_USB_UNKNOWN, SAMURAI_USB_SDP, SAMURAI_USB_CDP,
+	SAMURAI_USB_DCP, SAMURAI_USB_TYPE_C,
+};
+
+struct samurai_usb_budget {
+	int online;
+	enum samurai_usb_kind kind;
+	int current_ua;
+};
+
+/* A detection result is an advertised allowance, never a current measurement.
+ * SDP requires the UDC's configured/suspended budget, so leave it unavailable.
+ * No PD contract, proprietary charging mode or ambiguous result is inferred.
+ */
+static inline int samurai_usb_decode(const struct samurai_usb_status *s,
+				     struct samurai_usb_budget *b)
+{
+	unsigned int cc = s->cc & 0x7f;
+	unsigned int result = s->result & 0x7f;
+	int plugin = !!(s->plugin & 0x10);
+	int vbus = !!(s->misc & 0x20);
+	int attached = !!(s->misc & 1);
+	int state_attached = !!(s->attached & 0x20);
+
+	b->online = 0;
+	b->kind = SAMURAI_USB_UNKNOWN;
+	b->current_ua = -ENODATA;
+	if (!plugin && !vbus && !attached && !state_attached) {
+		b->current_ua = 0;
+		return 0;
+	}
+	/* Transitional, source-role, water/error and noncompliant states fail. */
+	if (!plugin || !vbus || !attached || !state_attached ||
+	    (s->misc & 0xd0) || !(s->misc & 8) || (s->legacy & 1) ||
+	    (s->plugin & 0x2f))
+		return -ENODATA;
+	if (cc != 8 && cc != 4 && cc != 2)
+		return -ENODATA;
+	b->online = 1;
+	/* A completed QC detection is outside this observer's contract. */
+	if ((s->apsd & 2) || (result & 0x60))
+		return 0;
+	if (!(s->legacy & 2) && (cc == 4 || cc == 2)) {
+		b->kind = SAMURAI_USB_TYPE_C;
+		b->current_ua = cc == 4 ? 1500000 : 3000000;
+		return 0;
+	}
+	if (!(s->apsd & 1))
+		return 0;
+	switch (result) {
+	case 1:
+		b->kind = SAMURAI_USB_SDP;
+		break;
+	case 4:
+		b->kind = SAMURAI_USB_CDP;
+		b->current_ua = 1500000;
+		break;
+	case 8:
+		b->kind = SAMURAI_USB_DCP;
+		b->current_ua = 1500000;
+		break;
+	}
+	return 0;
+}
+
+static inline int samurai_usb_status_equal(const struct samurai_usb_status *a,
+					   const struct samurai_usb_status *b)
+{
+	return a->apsd == b->apsd && a->result == b->result &&
+	       a->plugin == b->plugin && a->cc == b->cc &&
+	       a->attached == b->attached && a->misc == b->misc &&
+	       a->legacy == b->legacy;
+}
+
+/* DWC3's accepted SET_CONFIGURATION/reset/suspend callback is an input
+ * allowance, not an ADC reading. This USB2 board must never infer 900mA.
+ */
+static inline int samurai_usb_apply_udc(struct samurai_usb_budget *b,
+				       int valid, int current_ua)
+{
+	if (b->kind != SAMURAI_USB_SDP || !b->online) return 0;
+	if (!valid || current_ua < 0 || current_ua > 500000) {
+		b->current_ua = -ENODATA;
+		return 0;
+	}
+	b->current_ua = current_ua;
+	return 0;
+}
+
+#endif
diff --git a/drivers/power/supply/samurai-gauge-protection.c b/drivers/power/supply/samurai-gauge-protection.c
new file mode 100644
--- /dev/null
+++ b/drivers/power/supply/samurai-gauge-protection.c
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fresh, read-only factory-family safety/PF/FET-state provider. */
+#include <linux/i2c.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include "gauge-i2c.h"
+
+static bool register_board;
+module_param(register_board, bool, 0444);
+MODULE_PARM_DESC(register_board, "Create the RMX1931 observation device without changing DT");
+
+struct sm_protection {
+	struct i2c_client *gauge;
+	struct mutex lock;
+	unsigned int id, safety, permanent, operation, manufacturing;
+	int last_error;
+};
+
+static struct platform_device *sm_board;
+
+static int sm_protection_read(struct sm_protection *p)
+{
+	static const unsigned int commands[] = { 1, 0x51, 0x53, 0x54, 0x57 };
+	unsigned int *values[] = { &p->id, &p->safety, &p->permanent,
+		&p->operation, &p->manufacturing };
+	unsigned char packet[36];
+	int ret = 0;
+
+	i2c_lock_bus(p->gauge->adapter, I2C_LOCK_SEGMENT);
+	for (int i = 0; i < ARRAY_SIZE(commands); i++) {
+		ret = sm_gauge_mac_locked(p->gauge, commands[i], packet);
+		if (ret) break;
+		*values[i] = sm_mac_data_size(commands[i]) == 2 ?
+			sm_le16(packet + 2) : sm_le32(packet + 2);
+	}
+	i2c_unlock_bus(p->gauge->adapter, I2C_LOCK_SEGMENT);
+	if (!ret)
+		ret = sm_gauge_protection_state(p->id, p->safety, p->permanent,
+			p->operation, p->manufacturing);
+	p->last_error = ret;
+	return ret;
+}
+
+static int sm_protection_get(struct power_supply *psy,
+			     enum power_supply_property property,
+			     union power_supply_propval *value)
+{
+	struct sm_protection *p = power_supply_get_drvdata(psy);
+	int ret;
+
+	if (property == POWER_SUPPLY_PROP_MODEL_NAME) {
+		value->strval = "samurai-factory-2719-protection-status";
+		return 0;
+	}
+	mutex_lock(&p->lock);
+	ret = sm_protection_read(p); /* No cached Good on a failed transfer. */
+	if (!ret) {
+		if (property == POWER_SUPPLY_PROP_PRESENT) value->intval = 1;
+		else if (property == POWER_SUPPLY_PROP_HEALTH) value->intval = POWER_SUPPLY_HEALTH_GOOD;
+		else ret = -EINVAL;
+	}
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static ssize_t protection_state_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct sm_protection *p = dev_get_drvdata(dev);
+	ssize_t length;
+
+	mutex_lock(&p->lock);
+	sm_protection_read(p);
+	length = sysfs_emit(buf, "id=0x%x safety=0x%x pf=0x%x operation=0x%x "
+		"manufacturing=0x%x pf_enabled=%d error=%d\n", p->id, p->safety,
+		p->permanent, p->operation, p->manufacturing,
+		!!(p->manufacturing & 0x40), p->last_error);
+	mutex_unlock(&p->lock);
+	return length;
+}
+static DEVICE_ATTR_RO(protection_state);
+static struct attribute *sm_protection_attrs[] = { &dev_attr_protection_state.attr, NULL };
+static const struct attribute_group sm_protection_group = { .attrs = sm_protection_attrs };
+static const enum power_supply_property sm_protection_properties[] = {
+	POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_HEALTH, POWER_SUPPLY_PROP_MODEL_NAME,
+};
+static const struct power_supply_desc sm_protection_desc = {
+	.name = "samurai-gauge-protection", .type = POWER_SUPPLY_TYPE_UNKNOWN,
+	.properties = sm_protection_properties,
+	.num_properties = ARRAY_SIZE(sm_protection_properties), .get_property = sm_protection_get,
+	.no_thermal = true,
+};
+
+static void sm_protection_put(void *data) { put_device(data); }
+
+static int sm_protection_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *node;
+	struct power_supply_config config = { 0 };
+	struct power_supply *psy;
+	struct sm_protection *p;
+	int ret;
+
+	if (!of_machine_is_compatible("realme,samurai") ||
+	    IS_ENABLED(CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM)) return -ENODEV;
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p) return -ENOMEM;
+	node = dev->of_node ? of_parse_phandle(dev->of_node, "battery-gauge", 0) : NULL;
+	if (!node && register_board)
+		node = of_find_node_by_path("/soc@0/geniqup@cc0000/i2c@c94000/fuel-gauge@55");
+	if (!node) return -EINVAL;
+	p->gauge = of_find_i2c_device_by_node(node);
+	of_node_put(node);
+	if (!p->gauge) return -EPROBE_DEFER;
+	ret = devm_add_action_or_reset(dev, sm_protection_put, &p->gauge->dev);
+	if (ret) return ret;
+	if (p->gauge->addr != 0x55 || !i2c_check_functionality(p->gauge->adapter,
+		I2C_FUNC_I2C | I2C_FUNC_SMBUS_WORD_DATA)) return -EOPNOTSUPP;
+	/* A device reference protects lifetime, not system-sleep ordering. Fresh
+	 * MAC reads must wait for the gauge and its I2C parent to resume first.
+	 */
+	if (!device_link_add(dev, &p->gauge->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		return -ENOMEM;
+	mutex_init(&p->lock);
+	platform_set_drvdata(pdev, p);
+	ret = sm_protection_read(p);
+	if (ret) return dev_err_probe(dev, ret, "factory gauge protection protocol/state\n");
+	config.drv_data = p;
+	config.fwnode = dev_fwnode(dev);
+	psy = devm_power_supply_register(dev, &sm_protection_desc, &config);
+	if (IS_ERR(psy)) return PTR_ERR(psy);
+	return devm_device_add_group(dev, &sm_protection_group);
+}
+
+static const struct of_device_id sm_protection_match[] = {
+	{ .compatible = "realme,samurai-gauge-protection" }, { }
+};
+MODULE_DEVICE_TABLE(of, sm_protection_match);
+static struct platform_driver sm_protection_driver = {
+	.probe = sm_protection_probe,
+	.driver = { .name = "samurai-gauge-protection", .of_match_table = sm_protection_match },
+};
+static int __init sm_protection_init(void)
+{
+	int ret = platform_driver_register(&sm_protection_driver);
+	if (ret || !register_board) return ret;
+	sm_board = platform_device_register_simple("samurai-gauge-protection", -1, NULL, 0);
+	if (IS_ERR(sm_board)) {
+		ret = PTR_ERR(sm_board);
+		platform_driver_unregister(&sm_protection_driver);
+	}
+	return ret;
+}
+static void __exit sm_protection_exit(void)
+{
+	if (register_board && !IS_ERR_OR_NULL(sm_board)) platform_device_unregister(sm_board);
+	platform_driver_unregister(&sm_protection_driver);
+}
+module_init(sm_protection_init);
+module_exit(sm_protection_exit);
+MODULE_DESCRIPTION("RMX1931 factory-family gauge protection status, no protection writes");
+MODULE_LICENSE("GPL");
