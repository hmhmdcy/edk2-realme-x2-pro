+	if (!cpas->mmcx_link) {
+		dev_pm_domain_detach(cpas->mmcx, true);
+		return -EINVAL;
+	}
+	ret = devm_add_action_or_reset(dev, camss_cpas_release, cpas);
+	if (ret)
+		return ret;
 	camss->cpas = cpas;
