Subject: [PATCH] arm64: dts: samurai: route speaker MI2S RX over SD1

The board's OEM quaternary MI2S RX mask selects SD1, carried on GPIO140.
Use that data line and its matching active/sleep pin states so PCM reaches
the two MAX98937 amplifiers. Keep their configuration and gain unchanged.

---
--- a/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
@@ -796,7 +796,7 @@
 					pinctrl-1 = <&samurai_quat_sleep>;
 					dai@16 {
 						reg = <QUATERNARY_MI2S_RX>;
-						qcom,sd-lines = <0>;
+						qcom,sd-lines = <1>;
 					};
 				};
 			};
@@ -830,13 +830,13 @@
 
 &tlmm {
 	samurai_quat_audio: samurai-quat-audio-state {
-		pins = "gpio137", "gpio138", "gpio139";
+		pins = "gpio137", "gpio138", "gpio140";
 		function = "qua_mi2s";
 		drive-strength = <8>;
 		bias-disable;
 	};
 	samurai_quat_sleep: samurai-quat-sleep-state {
-		pins = "gpio137", "gpio138", "gpio139";
+		pins = "gpio137", "gpio138", "gpio140";
 		function = "gpio";
 		drive-strength = <2>;
 		bias-pull-down;
