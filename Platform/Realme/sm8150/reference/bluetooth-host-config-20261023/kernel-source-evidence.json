            "13:",
            "14:bluetooth-y := af_bluetooth.o hci_core.o hci_conn.o hci_event.o mgmt.o \\",
            "15:\thci_sock.o hci_sysfs.o l2cap_core.o l2cap_sock.o smp.o lib.o \\",
