            "17:\thci_drv.o",
            "18:",
            "19:bluetooth-$(CONFIG_DEV_COREDUMP) += coredump.o",
            "20:",
            "21:bluetooth-$(CONFIG_BT_BREDR) += sco.o",
            "22:bluetooth-$(CONFIG_BT_LE) += iso.o",
            "23:bluetooth-$(CONFIG_BT_LEDS) += leds.o",
            "24:bluetooth-$(CONFIG_BT_MSFTEXT) += msft.o",
            "25:bluetooth-$(CONFIG_BT_AOSPEXT) += aosp.o",
