    "drivers/hid/Kconfig": {
      "git_blob": "c43e824428f02ec0b05ed365e7b83b45e8955e5d",
      "sha256": "30c55695a476b95a021d065a5a85f7acfa6e814600807b62b74c00a7e537842d",
      "excerpts": [
        {
          "first": 1,
          "last": 26,
          "lines": [
            "1:# SPDX-License-Identifier: GPL-2.0-only",
            "2:#",
            "3:# HID driver configuration",
            "4:#",
            "5:menuconfig HID_SUPPORT",
            "6:\tbool \"HID bus support\"",
            "7:\tdefault y",
            "8:\tdepends on INPUT",
            "9:\thelp",
            "10:\t  This option adds core support for human interface device (HID).",
            "11:\t  You will also need drivers from the following menu to make use of it.",
            "12:",
            "13:if HID_SUPPORT",
            "14:",
            "15:config HID",
            "16:\ttristate \"HID bus core support\"",
            "17:\tdefault y",
            "18:\tdepends on INPUT",
            "19:\thelp",
            "20:\t  A human interface device (HID) is a type of computer device that",
            "21:\t  interacts directly with and takes input from humans. The term \"HID\"",
            "22:\t  most commonly used to refer to the USB-HID specification, but other",
            "23:\t  devices (such as, but not strictly limited to, Bluetooth) are",
            "24:\t  designed using HID specification (this involves certain keyboards,",
            "25:\t  mice, tablets, etc). This option adds the HID bus to the kernel,",
            "26:\t  together with generic HID layer code. The HID devices are added and"
          ]
        },
        {
          "first": 63,
          "last": 81,
          "lines": [
            "63:config UHID",
            "64:\ttristate \"User-space I/O driver support for HID subsystem\"",
            "65:\tdefault n",
            "66:\thelp",
            "67:\tSay Y here if you want to provide HID I/O Drivers from user-space.",
            "68:\tThis allows to write I/O drivers in user-space and feed the data from",
            "69:\tthe device into the kernel. The kernel parses the HID reports, loads the",
            "70:\tcorresponding HID Device Driver or provides input devices on top of your",
            "71:\tuser-space device.",
            "72:",
            "73:\tThis driver cannot be used to parse HID-reports in user-space and write",
            "74:\tspecial HID-drivers. You should use hidraw for that.",
            "75:\tInstead, this driver allows to write the transport-layer driver in",
            "76:\tuser-space like USB-HID and Bluetooth-HID do in kernel-space.",
            "77:",
            "78:\tIf unsure, say N.",
            "79:",
            "80:\tTo compile this driver as a module, choose M here: the",
            "81:\tmodule will be called uhid."
          ]
        }
      ]
    },
