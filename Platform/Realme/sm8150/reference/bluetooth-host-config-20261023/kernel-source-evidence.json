    "net/bluetooth/Kconfig": {
      "git_blob": "1cda01614efec4ab53aa1e3cc0dfab19e9ddb813",
      "sha256": "cf49b6becb0a34174f5dcec2e69893e0438d29d7261d78f0e334e4b2004993ac",
      "excerpts": [
        {
          "first": 1,
          "last": 82,
          "lines": [
            "1:# SPDX-License-Identifier: GPL-2.0-only",
            "2:#",
            "3:# Bluetooth subsystem configuration",
            "4:#",
            "5:",
            "6:menuconfig BT",
            "7:\ttristate \"Bluetooth subsystem support\"",
            "8:\tdepends on !S390",
            "9:\tdepends on RFKILL || !RFKILL",
            "10:\tselect CRC16",
            "11:\tselect CRYPTO",
            "12:\tselect CRYPTO_LIB_AES",
            "13:\tselect CRYPTO_LIB_AES_CBC_MACS",
            "14:\tselect CRYPTO_ECDH",
            "15:\thelp",
            "16:\t  Bluetooth is low-cost, low-power, short-range wireless technology.",
            "17:\t  It was designed as a replacement for cables and other short-range",
            "18:\t  technologies like IrDA.  Bluetooth operates in personal area range",
            "19:\t  that typically extends up to 10 meters.  More information about",
            "20:\t  Bluetooth can be found at <https://www.bluetooth.com/>.",
            "21:",
            "22:\t  Linux Bluetooth subsystem consist of several layers:",
            "23:\t     Bluetooth Core",
            "24:\t\tHCI device and connection manager, scheduler",
            "25:\t\tSCO audio links",
            "26:\t\tL2CAP (Logical Link Control and Adaptation Protocol)",
            "27:\t\tSMP (Security Manager Protocol) on LE (Low Energy) links",
            "28:\t\tISO isochronous links",
            "29:\t     HCI Device drivers (Interface to the hardware)",
            "30:\t     RFCOMM Module (RFCOMM Protocol)  ",
            "31:\t     BNEP Module (Bluetooth Network Encapsulation Protocol)",
            "32:\t     HIDP Module (Human Interface Device Protocol)",
            "33:",
            "34:\t  Say Y here to compile Bluetooth support into the kernel or say M to",
            "35:\t  compile it as module (bluetooth).",
            "36:",
            "37:\t  To use Linux Bluetooth subsystem, you will need several user-space",
            "38:\t  utilities like hciconfig and bluetoothd.  These utilities and updates",
            "39:\t  to Bluetooth kernel modules are provided in the BlueZ packages.  For",
            "40:\t  more information, see <http://www.bluez.org/>.",
            "41:",
            "42:config BT_BREDR",
            "43:\tbool \"Bluetooth Classic (BR/EDR) features\"",
            "44:\tdepends on BT",
            "45:\tdefault y",
            "46:\thelp",
            "47:\t  Bluetooth Classic includes support for Basic Rate (BR)",
            "48:\t  available with Bluetooth version 1.0b or later and support",
            "49:\t  for Enhanced Data Rate (EDR) available with Bluetooth",
            "50:\t  version 2.0 or later.",
            "51:",
            "52:source \"net/bluetooth/rfcomm/Kconfig\"",
            "53:",
            "54:source \"net/bluetooth/bnep/Kconfig\"",
            "55:",
            "56:source \"net/bluetooth/hidp/Kconfig\"",
            "57:",
            "58:config BT_LE",
            "59:\tbool \"Bluetooth Low Energy (LE) features\"",
            "60:\tdepends on BT",
            "61:\tdefault y",
            "62:\thelp",
            "63:\t  Bluetooth Low Energy includes support low-energy physical",
            "64:\t  layer available with Bluetooth version 4.0 or later.",
            "65:",
            "66:config BT_LE_L2CAP_ECRED",
            "67:\tbool \"Bluetooth L2CAP Enhanced Credit Flow Control\"",
            "68:\tdepends on BT_LE",
            "69:\tdefault y",
            "70:\thelp",
            "71:\t  Bluetooth Low Energy L2CAP Enhanced Credit Flow Control available with",
            "72:\t  Bluetooth version 5.2 or later.",
            "73:",
            "74:\t  This can be overridden by passing bluetooth.enable_ecred=[1|0]",
            "75:\t  on the kernel commandline.",
            "76:",
            "77:config BT_6LOWPAN",
            "78:\ttristate \"Bluetooth 6LoWPAN support\"",
            "79:\tdepends on BT && BT_LE && 6LOWPAN",
            "80:\thelp",
            "81:\t  IPv6 compression over Bluetooth Low Energy.",
            "82:"
          ]
        }
      ]
    },
