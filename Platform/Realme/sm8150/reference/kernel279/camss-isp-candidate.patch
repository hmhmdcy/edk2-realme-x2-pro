+void vfe_880_enable_aec_bhist(struct vfe_device *vfe, bool enable)
+{
+	u32 value = readl_relaxed(vfe->base + IFE_STATS_AEC_BHIST_MODULE_CFG);
+
+	if (enable)
+		value |= BIT(0);
+	else
+		value &= ~BIT(0);
+
+	writel_relaxed(value, vfe->base + IFE_STATS_AEC_BHIST_MODULE_CFG);
+}
