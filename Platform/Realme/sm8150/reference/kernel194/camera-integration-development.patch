index 0000000..0d529b9
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx471.yaml
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx471.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX471 CMOS Image Sensor
+
+maintainers:
+  - Danila Tikhonov <danila@mainlining.org>
+
+description:
+  The Sony IMX471 is a 16-megapixel image sensor with a 4656 by 3496 active
+  pixel array. It is controlled through I2C and transmits image data over
+  a two-lane or four-lane MIPI CSI-2 D-PHY interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx471
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: External input clock, 19.2 MHz
+    maxItems: 1
+
+  vana-supply:
+    description: Analog supply, 2.8 V
+
+  vdig-supply:
+    description: Digital core supply, nominally 1.05 V
+
+  vif-supply:
+    description: Interface supply, 1.8 V
+
+  reset-gpios:
+    description: Active low XCLR reset
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            oneOf:
+              - items:
+                  - const: 1
+                  - const: 2
+              - items:
+                  - const: 1
+                  - const: 2
+                  - const: 3
+                  - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - vana-supply
+  - vdig-supply
+  - vif-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,sm8150-camcc.h>
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "sony,imx471";
+            reg = <0x10>;
+            clocks = <&camcc CAM_CC_MCLK2_CLK>;
+            assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+            assigned-clock-rates = <19200000>;
+            vana-supply = <&camera_vana>;
+            vdig-supply = <&camera_vdig>;
+            vif-supply = <&camera_vif>;
+            reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <200000000>;
+                    remote-endpoint = <&csiphy2_ep>;
+                };
+            };
+        };
+    };
+...
diff --git a/drivers/of/samurai-cci-bringup.c b/drivers/of/samurai-cci-bringup.c
new file mode 100644
index 0000000..1c764aa
--- /dev/null
+++ b/drivers/of/samurai-cci-bringup.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Temporary live CCI1 activation for the realme X2 Pro camera port. */
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+
+static struct of_changeset cci_changes;
+static bool applied;
+
+static int __init samurai_cci_bringup_init(void)
+{
+	struct platform_device *pdev;
+	struct device_node *node;
+	const char *status;
+	int ret;
+
+	if (!of_machine_is_compatible("realme,samurai"))
+		return -ENODEV;
+
+	node = of_find_node_by_path("/soc@0/cci@ac4b000");
+	if (!node)
+		return -ENODEV;
+
+	if (!of_device_is_compatible(node, "qcom,sm8150-cci") ||
+	    of_property_read_string(node, "status", &status) ||
+	    strcmp(status, "disabled") ||
+	    of_node_check_flag(node, OF_POPULATED)) {
+		ret = -EBUSY;
+		goto put_node;
+	}
+
+	pdev = of_find_device_by_node(node);
+	if (pdev) {
+		platform_device_put(pdev);
+		ret = -EBUSY;
+		goto put_node;
+	}
+
+	of_changeset_init(&cci_changes);
+	ret = of_changeset_update_prop_string(&cci_changes, node, "status", "okay");
+	if (ret)
+		goto destroy;
+	ret = of_changeset_apply(&cci_changes);
+	/* A notifier can fail after the single property update took effect. */
+	applied = of_device_is_available(node);
+	if (ret)
+		goto revert;
+	if (!applied) {
+		ret = -EIO;
+		goto destroy;
+	}
+
+	pdev = of_find_device_by_node(node);
+	if (!pdev) {
+		ret = -ENODEV;
+		goto revert;
+	}
+	if (!device_is_bound(&pdev->dev)) {
+		platform_device_put(pdev);
+		ret = -EPROBE_DEFER;
+		goto revert;
+	}
+	dev_info(&pdev->dev, "samurai camera bringup: CCI1 live, no sensor power changes\n");
+	platform_device_put(pdev);
+	of_node_put(node);
+	return 0;
+
+revert:
+	if (applied && of_changeset_revert(&cci_changes))
+		pr_err("samurai camera bringup: failed to restore disabled CCI1\n");
+	applied = false;
+destroy:
+	of_changeset_destroy(&cci_changes);
+put_node:
+	of_node_put(node);
+	return ret;
+}
+
+static void __exit samurai_cci_bringup_exit(void)
+{
+	if (applied && of_changeset_revert(&cci_changes))
+		pr_err("samurai camera bringup: failed to restore disabled CCI1\n");
+	of_changeset_destroy(&cci_changes);
+}
+
+module_init(samurai_cci_bringup_init);
+module_exit(samurai_cci_bringup_exit);
+
+MODULE_DESCRIPTION("Temporary reversible realme X2 Pro CCI1 activation");
+MODULE_AUTHOR("Samurai Linux port contributors");
+MODULE_LICENSE("GPL");
