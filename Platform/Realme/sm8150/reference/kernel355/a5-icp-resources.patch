diff --git a/drivers/media/platform/qcom/camss/camss-icp-a5-power-test.c b/drivers/media/platform/qcom/camss/camss-icp-a5-power-test.c
new file mode 100644
index 000000000..3750c65a4
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-icp-a5-power-test.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Temporary resource lifecycle test. Never writes A5 control/reset registers. */
+#include <linux/bitops.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#include "camss-icp-a5-resources.h"
+#include "camss-icp-a5-power-test-blob.h"
+
+static char result[2048] = "{\"terminal\":false}";
+module_param_string(result, result, sizeof(result), 0444);
+static int overlay_id;
+
+static int power_resume(struct device *dev)
+{
+	return camss_a5_resources_resume(dev_get_drvdata(dev));
+}
+
+static int power_suspend(struct device *dev)
+{
+	return camss_a5_resources_suspend(dev_get_drvdata(dev));
+}
+
+static const struct dev_pm_ops power_ops = {
+	RUNTIME_PM_OPS(power_suspend, power_resume, NULL)
+};
+
+static int power_test_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct camss_a5_resources *res;
+	u32 version = 0, control = 0, status = 0;
+	unsigned int powered = 0, domains = 0, i;
+	unsigned long rates[19] = {};
+	int ret, suspend_error = 0;
+
+	res = devm_kzalloc(dev, sizeof(*res), GFP_KERNEL);
+	if (!res)
+		return -ENOMEM;
+	ret = camss_a5_resources_init(pdev, res);
+	if (ret) {
+		scnprintf(result, sizeof(result),
+			  "{\"terminal\":true,\"phase\":\"resources-init\",\"error\":%d}", ret);
+		return ret;
+	}
+	platform_set_drvdata(pdev, res);
+	pm_runtime_set_suspended(dev);
+	pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret >= 0) {
+		powered = res->enabled_groups;
+		domains = res->held_domains;
+		version = readl(res->sierra);
+		control = readl(res->sierra + 8);
+		status = readl(res->sierra + 0x200);
+		for (i = 0; i < ARRAY_SIZE(rates); i++)
+			rates[i] = clk_get_rate(res->clocks[i].clk);
+		ret = version && version != U32_MAX && !(control & BIT(9)) &&
+			powered == 15 && domains == 7 ? 0 : -EIO;
+		suspend_error = pm_runtime_put_sync_suspend(dev);
+		if (suspend_error > 0)
+			suspend_error = 0;
+	}
+	scnprintf(result, sizeof(result),
+		  "{\"terminal\":true,\"phase\":\"done\",\"error\":%d,\"suspend_error\":%d,"
+		  "\"powered_groups\":%u,\"powered_domains\":%u,\"remaining_groups\":%u,"
+		  "\"remaining_domains\":%u,\"version\":%u,\"control\":%u,\"status\":%u,"
+		  "\"rates\":[%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu],"
+		  "\"runtime_suspended\":%s,\"firmware_started\":false}",
+		  ret, suspend_error, powered, domains, res->enabled_groups,
+		  res->held_domains, version, control, status,
+		  rates[0], rates[1], rates[2], rates[3], rates[4], rates[5], rates[6],
+		  rates[7], rates[8], rates[9], rates[10], rates[11], rates[12],
+		  rates[13], rates[14], rates[15], rates[16], rates[17], rates[18],
+		  pm_runtime_status_suspended(dev) ? "true" : "false");
+	return 0;
+}
+
+static void power_test_remove(struct platform_device *pdev)
+{
+	struct camss_a5_resources *res = platform_get_drvdata(pdev);
+
+	pm_runtime_disable(&pdev->dev);
+	if (res->enabled_groups || res->held_domains)
+		camss_a5_resources_suspend(res);
+	camss_a5_resources_release(res);
+}
+
+static const struct of_device_id power_test_match[] = {
+	{ .compatible = "realme,samurai-a5-icp-power-test" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, power_test_match);
+
+static struct platform_driver power_test_driver = {
+	.probe = power_test_probe,
+	.remove = power_test_remove,
+	.driver = {
+		.name = "samurai-a5-icp-power-test",
+		.of_match_table = power_test_match,
+		.pm = pm_ptr(&power_ops),
+		.probe_type = PROBE_FORCE_SYNCHRONOUS,
+	},
+};
+
+static int __init power_test_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&power_test_driver);
+	if (ret)
+		return ret;
+	ret = of_overlay_fdt_apply(a5_power_test_overlay,
+				  sizeof(a5_power_test_overlay), &overlay_id, NULL);
+	if (ret) {
+		if (overlay_id > 0)
+			of_overlay_remove(&overlay_id);
+		platform_driver_unregister(&power_test_driver);
+	}
+	return ret;
+}
+
+static void __exit power_test_exit(void)
+{
+	of_overlay_remove(&overlay_id);
+	platform_driver_unregister(&power_test_driver);
+}
+
+module_init(power_test_init);
+module_exit(power_test_exit);
+MODULE_DESCRIPTION("Temporary A5/BPS/IPE resource lifecycle diagnostic");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/qcom/camss/camss-icp-a5-resources.c b/drivers/media/platform/qcom/camss/camss-icp-a5-resources.c
new file mode 100644
index 000000000..d26b5fd98
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-icp-a5-resources.c
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM8150 A5/BPS/IPE resources; CPAS remains owned by the CAMSS supplier. */
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#include "camss-icp-a5-resources.h"
+
+static const char * const domain_names[] = { "bps", "ipe0", "ipe1" };
+static const char * const clock_names[] = {
+	"fast_ahb_src", "icp_ahb", "icp_src", "icp",
+	"bps_ahb", "bps_areg", "bps_axi", "bps_src", "bps",
+	"ipe0_ahb", "ipe0_areg", "ipe0_axi", "ipe_src", "ipe0",
+	"ipe1_ahb", "ipe1_areg", "ipe1_axi", "ipe1_src", "ipe1",
+};
+static const unsigned int group_offset[] = { 0, 4, 9, 14 };
+static const unsigned int group_count[] = { 4, 5, 5, 5 };
+
+static void camss_a5_delete_link(void *data)
+{
+	device_link_del(data);
+}
+
+int camss_a5_resources_init(struct platform_device *pdev,
+			    struct camss_a5_resources *res)
+{
+	const struct dev_pm_domain_attach_data attach = {
+		.pd_names = domain_names,
+		.num_pd_names = ARRAY_SIZE(domain_names),
+		.pd_flags = PD_FLAG_NO_DEV_LINK | PD_FLAG_DETACH_POWER_OFF,
+	};
+	struct device *dev = &pdev->dev;
+	struct platform_device *supplier;
+	struct device_node *node;
+	unsigned int i;
+	int ret;
+
+	if (res->dev)
+		return -EBUSY;
+	node = of_parse_phandle(dev->of_node, "qcom,camss", 0);
+	if (!node)
+		return -EINVAL;
+	supplier = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!supplier)
+		return -EPROBE_DEFER;
+	if (!device_is_bound(&supplier->dev)) {
+		put_device(&supplier->dev);
+		return -EPROBE_DEFER;
+	}
+	res->camss_link = device_link_add(dev, &supplier->dev,
+					DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS);
+	put_device(&supplier->dev);
+	if (!res->camss_link)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, camss_a5_delete_link, res->camss_link);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(clock_names); i++)
+		res->clocks[i].id = clock_names[i];
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(res->clocks), res->clocks);
+	if (ret)
+		return ret;
+	res->sierra = devm_platform_ioremap_resource_byname(pdev, "sierra");
+	if (IS_ERR(res->sierra))
+		return PTR_ERR(res->sierra);
+	res->bps = devm_platform_ioremap_resource_byname(pdev, "bps");
+	if (IS_ERR(res->bps))
+		return PTR_ERR(res->bps);
+	res->ipe[0] = devm_platform_ioremap_resource_byname(pdev, "ipe0");
+	if (IS_ERR(res->ipe[0]))
+		return PTR_ERR(res->ipe[0]);
+	res->ipe[1] = devm_platform_ioremap_resource_byname(pdev, "ipe1");
+	if (IS_ERR(res->ipe[1]))
+		return PTR_ERR(res->ipe[1]);
+	ret = devm_pm_domain_attach_list(dev, &attach, &res->domains);
+	if (ret < 0)
+		return ret;
+	if (!res->domains || res->domains->num_pds != ARRAY_SIZE(domain_names))
+		return -ENODEV;
+	res->dev = dev;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(camss_a5_resources_init);
+
+int camss_a5_resources_suspend(struct camss_a5_resources *res)
+{
+	int group, ret, first_error = 0;
+
+	if (!res->dev)
+		return -EINVAL;
+	for (group = 3; group >= 0; group--) {
+		if (res->enabled_groups & BIT(group)) {
+			clk_bulk_disable_unprepare(group_count[group],
+						   res->clocks + group_offset[group]);
+			res->enabled_groups &= ~BIT(group);
+		}
+		if (group && (res->held_domains & BIT(group - 1))) {
+			ret = pm_runtime_put_sync(res->domains->pd_devs[group - 1]);
+			res->held_domains &= ~BIT(group - 1);
+			if (ret < 0 && !first_error)
+				first_error = ret;
+		}
+	}
+	return first_error;
+}
+EXPORT_SYMBOL_GPL(camss_a5_resources_suspend);
+
+int camss_a5_resources_resume(struct camss_a5_resources *res)
+{
+	/* Original SM8150 SVS rates; IPE1 shares IPE0's source. */
+	static const unsigned int rate_index[] = { 0, 2, 7, 12 };
+	static const unsigned long rates[] = {
+		200000000, 400000000, 400000000, 475000000,
+	};
+	unsigned int group, i;
+	int ret, unwind;
+
+	if (!res->dev)
+		return -EINVAL;
+	if (res->enabled_groups || res->held_domains)
+		return -EBUSY;
+	for (i = 0; i < ARRAY_SIZE(rates); i++) {
+		ret = clk_set_rate(res->clocks[rate_index[i]].clk, rates[i]);
+		if (ret)
+			return ret;
+	}
+	for (group = 0; group < ARRAY_SIZE(group_offset); group++) {
+		if (group) {
+			ret = pm_runtime_resume_and_get(res->domains->pd_devs[group - 1]);
+			if (ret < 0)
+				goto unwind;
+			res->held_domains |= BIT(group - 1);
+		}
+		ret = clk_bulk_prepare_enable(group_count[group],
+					    res->clocks + group_offset[group]);
+		if (ret)
+			goto unwind;
+		res->enabled_groups |= BIT(group);
+	}
+	return 0;
+unwind:
+	unwind = camss_a5_resources_suspend(res);
+	if (unwind)
+		dev_err(res->dev, "A5 resource unwind failed: %d\n", unwind);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(camss_a5_resources_resume);
+
+int camss_a5_resources_release(struct camss_a5_resources *res)
+{
+	if (res->enabled_groups || res->held_domains)
+		return -EBUSY;
+	/* devres releases the link, clocks, mappings and attached domains. */
+	res->dev = NULL;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(camss_a5_resources_release);
diff --git a/drivers/media/platform/qcom/camss/camss-icp-a5-resources.h b/drivers/media/platform/qcom/camss/camss-icp-a5-resources.h
new file mode 100644
index 000000000..1cc435b10
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-icp-a5-resources.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef CAMSS_ICP_A5_RESOURCES_H
+#define CAMSS_ICP_A5_RESOURCES_H
+
+#include <linux/clk.h>
+#include <linux/pm_domain.h>
+
+struct platform_device;
+
+/* The owner serializes these calls and stops A5 before suspending resources. */
+struct camss_a5_resources {
+	struct device *dev;
+	struct device_link *camss_link;
+	struct dev_pm_domain_list *domains;
+	struct clk_bulk_data clocks[19];
+	u8 enabled_groups;
+	u8 held_domains;
+	void __iomem *sierra;
+	void __iomem *bps;
+	void __iomem *ipe[2];
+};
+
+int camss_a5_resources_init(struct platform_device *pdev,
+			    struct camss_a5_resources *res);
+int camss_a5_resources_resume(struct camss_a5_resources *res);
+int camss_a5_resources_suspend(struct camss_a5_resources *res);
+int camss_a5_resources_release(struct camss_a5_resources *res);
+
+#endif
