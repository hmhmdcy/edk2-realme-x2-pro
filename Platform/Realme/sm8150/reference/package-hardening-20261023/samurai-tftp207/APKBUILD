# Adopt the already built and source-verified207 artifact; source rebuild is
# linux-port/radio/build-tftp.py. Do not silently substitute a new toolchain build.
maintainer="Realme X2 Pro Linux port"
pkgname=samurai-tftp207
pkgver=0.1.0
pkgrel=0
pkgdesc="Validated Realme X2 Pro RAM work-file TFTP server"
url="https://github.com/hmhmdcy/pmaports"
arch="aarch64"
license="BSD-3-Clause"
options="!check !strip"
install="$pkgname.pre-install $pkgname.pre-upgrade"
source="samurai-tftp207.pre-install samurai-tftp207.pre-upgrade samurai-tqftpserv-207 source-lock.json REBUILD.md tqftpserv-LICENSE qrtr-LICENSE"
# File owner/replaces is deliberately pending the current device query.
package() {
    install -Dm755 "$srcdir"/samurai-tqftpserv-207 "$pkgdir"/usr/sbin/samurai-tqftpserv
    for name in source-lock.json REBUILD.md tqftpserv-LICENSE qrtr-LICENSE; do
        install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/doc/$pkgname/$name"
    done
}
