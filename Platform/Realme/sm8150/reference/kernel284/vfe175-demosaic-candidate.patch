 		.g_gain = 1024,
@@ -112,6 +118,13 @@ void vfe_175_pixel_prepare(struct vfe_line *line)
 		.wb_enabled = true,
 	};
 	vfe_175_wb_write(vfe);
+
+	return 0;
+}
+
+void vfe_175_pixel_stop(struct vfe_device *vfe)
+{
+	vfe_175_demosaic_stop(vfe);
 }
 
