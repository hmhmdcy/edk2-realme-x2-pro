## @file
# EUD (Embedded USB Debug) COM SerialPortLib for the realme X2 Pro (samurai).
#
# Producer side of the EUD log ring buffer: SerialPortWrite() only copies bytes
# into RAM (see EudLog.h).  The EUD hardware is driven exclusively by
# Platform/Realme/sm8150/EudLogDxe, so this library needs no IoLib/TimerLib and
# is safe to call from any DXE context.
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = EudSerialPortLib
  FILE_GUID      = 7F3C1E64-2B7A-4E6D-9A15-58C4D2E0B7A3
  MODULE_TYPE    = BASE
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = SerialPortLib

[Sources.common]
  EudSerialPortLib.c
  EudLog.h

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseLib
  SynchronizationLib
