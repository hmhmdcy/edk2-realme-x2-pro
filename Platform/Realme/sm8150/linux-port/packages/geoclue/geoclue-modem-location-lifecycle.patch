+++ b/tests/test-modem-lifecycle.c
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Exercise the production backend, including replies after a stop/cancellation. */
+#include <libmm-glib.h>
+#include <gio/gio.h>
+
+typedef struct {
+    GObject *proxy;
+    MMModemLocationSource caps;
+    gboolean signals;
+    GAsyncReadyCallback callback;
+    gpointer data;
+} Pending;
+static GQueue pending;
+static MMModemLocationSource enabled;
+static gboolean signals_location;
+static guint refresh_rate, cached_rate, writes;
+static gboolean stale_rate_cache;
+
+static MMModemLocationSource fake_enabled(MMModemLocation *p) { (void)p; return enabled; }
+static gboolean fake_signals(MMModemLocation *p) { (void)p; return signals_location; }
+static guint fake_rate(MMModemLocation *p) { (void)p; return stale_rate_cache ? cached_rate : refresh_rate; }
+static gboolean fake_set_rate(MMModemLocation *p, guint rate, GCancellable *c, GError **e)
+{
+    (void)p; (void)e; g_assert_null(c); refresh_rate=rate; writes++; return TRUE;
+}
+static gboolean fake_setup_sync(MMModemLocation *p, MMModemLocationSource caps,
+                                gboolean signals, GCancellable *c, GError **e)
+{
+    (void)p; (void)e; g_assert_null(c); enabled=caps; signals_location=signals; return TRUE;
+}
+static void fake_setup(MMModemLocation *p, MMModemLocationSource caps,
+                       gboolean signals, GCancellable *c,
+                       GAsyncReadyCallback callback, gpointer data)
+{
+    Pending *q=g_new0(Pending,1);g_assert_null(c);
+    q->proxy=g_object_ref(G_OBJECT(p));q->caps=caps;q->signals=signals;
+    q->callback=callback;q->data=data;g_queue_push_tail(&pending,q);
+}
+static gboolean fake_setup_finish(MMModemLocation *p, GAsyncResult *r, GError **e)
+{ (void)p; return g_task_propagate_boolean(G_TASK(r),e); }
+static MMLocationGpsNmea *fake_nmea(MMModemLocation *p) { (void)p;return NULL; }
+static void fake_bus_get(GBusType type, GCancellable *c, GAsyncReadyCallback cb, gpointer data)
+{ (void)type;(void)c;(void)cb;(void)data; }
+
+#undef MM_MODEM_LOCATION
+#define MM_MODEM_LOCATION(p) ((MMModemLocation *)(p))
+#define mm_modem_location_get_enabled fake_enabled
+#define mm_modem_location_signals_location fake_signals
+#define mm_modem_location_get_gps_refresh_rate fake_rate
+#define mm_modem_location_set_gps_refresh_rate_sync fake_set_rate
+#define mm_modem_location_setup fake_setup
+#define mm_modem_location_setup_sync fake_setup_sync
+#define mm_modem_location_setup_finish fake_setup_finish
+#define mm_modem_location_get_signaled_gps_nmea fake_nmea
+#define g_bus_get fake_bus_get
+#include "../src/gclue-modem-manager.c"
+
+static GClueModemManager *manager_new(guint caps, gboolean signals, guint rate)
+{
+    GClueModemManager *m;
+    g_assert_true(g_queue_is_empty(&pending));
+    enabled=caps;signals_location=signals;refresh_rate=rate;cached_rate=rate;
+    writes=0;stale_rate_cache=FALSE;
+    m=g_object_new(GCLUE_TYPE_MODEM_MANAGER,NULL);
+    m->priv->modem_location=(MMModemLocation *)g_object_new(G_TYPE_OBJECT,NULL);
+    m->priv->time_threshold=1;
+    return m;
+}
+static void complete_one(void)
+{
+    Pending *q=g_queue_pop_head(&pending);g_assert_nonnull(q);
+    enabled=q->caps;signals_location=q->signals;
+    GTask *ack=g_task_new(q->proxy,NULL,NULL,NULL);
+    g_task_return_boolean(ack,TRUE);
+    q->callback(q->proxy,G_ASYNC_RESULT(ack),q->data);
+    g_object_unref(ack);g_object_unref(q->proxy);g_free(q);
+    while(g_main_context_iteration(NULL,FALSE));
+}
+static void stop_gps(GClueModemManager *m)
+{
+    GError *e=NULL;
+    g_assert_true(clear_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,&e));
+    g_assert_no_error(e);
+}
+static void test_normal(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);complete_one();
+    g_assert_cmpuint(enabled,==,4);g_assert_true(signals_location);g_assert_cmpuint(refresh_rate,==,1);
+    stop_gps(m);g_assert_cmpuint(enabled,==,0);g_assert_false(signals_location);g_assert_cmpuint(refresh_rate,==,30);
+    g_object_unref(m);
+}
+static void test_idle_threshold(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);
+    gclue_modem_manager_set_time_threshold(GCLUE_MODEM(m),0);
+    g_assert_cmpuint(writes,==,0);stop_gps(m);g_assert_cmpuint(writes,==,0);
+    g_assert_cmpuint(refresh_rate,==,30);g_assert_false(signals_location);g_object_unref(m);
+}
+static void test_preserve_external(void)
+{
+    GClueModemManager *m=manager_new(MM_MODEM_LOCATION_SOURCE_GPS_RAW,TRUE,17);
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);complete_one();
+    g_assert_cmpuint(enabled,==,6);stop_gps(m);
+    g_assert_cmpuint(enabled,==,2);g_assert_true(signals_location);g_assert_cmpuint(refresh_rate,==,17);
+    g_object_unref(m);
+}
+static void test_preexisting_gps(void)
+{
+    GClueModemManager *m=manager_new(MM_MODEM_LOCATION_SOURCE_GPS_NMEA,TRUE,11);
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);complete_one();stop_gps(m);
+    g_assert_cmpuint(enabled,==,4);g_assert_true(signals_location);g_assert_cmpuint(refresh_rate,==,11);
+    g_object_unref(m);
+}
+static void test_late_reply(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);stop_gps(m);
+    g_assert_cmpuint(m->priv->pending_setups,==,1);complete_one();
+    g_assert_cmpuint(enabled,==,0);g_assert_false(signals_location);g_assert_cmpuint(refresh_rate,==,30);
+    g_assert_cmpuint(m->priv->pending_setups,==,0);g_object_unref(m);
+}
+static void test_cancelled_reply(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);GCancellable *c=g_cancellable_new();
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,c,NULL,NULL);
+    g_cancellable_cancel(c);stop_gps(m);complete_one();
+    g_assert_cmpuint(enabled,==,0);g_assert_false(signals_location);g_assert_cmpuint(refresh_rate,==,30);
+    g_object_unref(c);g_object_unref(m);
+}
+static void test_rapid_restart(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);stop_gps(m);
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);
+    complete_one();complete_one();g_assert_cmpuint(enabled,==,4);g_assert_cmpuint(refresh_rate,==,1);
+    stop_gps(m);g_assert_cmpuint(enabled,==,0);g_assert_false(signals_location);g_assert_cmpuint(refresh_rate,==,30);
+    g_object_unref(m);
+}
+static void test_external_added(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);complete_one();
+    enabled|=MM_MODEM_LOCATION_SOURCE_GPS_RAW;stop_gps(m);
+    g_assert_cmpuint(enabled,==,2);g_assert_cmpuint(refresh_rate,==,30);g_object_unref(m);
+}
+static void test_stale_rate_cache(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);stale_rate_cache=TRUE;
+    enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);
+    g_assert_cmpuint(refresh_rate,==,1);stop_gps(m);complete_one();
+    g_assert_cmpuint(refresh_rate,==,30);g_assert_false(signals_location);g_assert_cmpuint(enabled,==,0);
+    g_object_unref(m);
+}
+static void test_repeated(void)
+{
+    GClueModemManager *m=manager_new(0,FALSE,30);
+    for(guint i=0;i<4;i++){
+        enable_caps(m,MM_MODEM_LOCATION_SOURCE_GPS_NMEA,NULL,NULL,NULL);complete_one();stop_gps(m);
+        g_assert_cmpuint(enabled,==,0);g_assert_false(signals_location);g_assert_cmpuint(refresh_rate,==,30);
+    }
+    g_object_unref(m);
+}
+int main(int argc,char **argv)
+{
+    g_test_init(&argc,&argv,NULL);
+    g_test_add_func("/modem-config/normal",test_normal);
+    g_test_add_func("/modem-config/idle-threshold",test_idle_threshold);
+    g_test_add_func("/modem-config/preserve-external",test_preserve_external);
+    g_test_add_func("/modem-config/preexisting-gps",test_preexisting_gps);
+    g_test_add_func("/modem-config/late-reply",test_late_reply);
+    g_test_add_func("/modem-config/cancelled-reply",test_cancelled_reply);
+    g_test_add_func("/modem-config/rapid-restart",test_rapid_restart);
+    g_test_add_func("/modem-config/external-added",test_external_added);
+    g_test_add_func("/modem-config/stale-rate-cache",test_stale_rate_cache);
+    g_test_add_func("/modem-config/repeated",test_repeated);
+    return g_test_run();
+}
